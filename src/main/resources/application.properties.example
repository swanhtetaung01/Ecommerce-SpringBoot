spring.application.name=springboot-ecomm

spring.h2.console.enabled=true/false
spring.datasource.url=jdbc:h2:mem:test
spring.datasource.username=
spring.datasource.password=

project.image=images/

spring.app.jwtSecretKey=
spring.app.jwtExpirationMs=

logger.level.org.springframework=DEBUG
logger.level.org.hibernate.SQL=DEBUG
logger.level.org.springframework.security=DEBUG
logger.level.com.ecommerce.project=DEBUG

spring.jpa.show-sql=true/false
spring.jpa.properties.hibernate.format_sql=true/false